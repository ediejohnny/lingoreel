<?vlc
--[[ This is not JSON: it is a page of VLC's Lua web interface, like VLC's
own lua\http\requests\status.json. VLC runs the code between the vlc
markers and answers with what it prints, which is JSON; the file name is
the address it is served at (/requests/lingoreel.json).

Control endpoint of the LingoReel. VLC's own status.json only
reports whole seconds; this one reports microseconds and accepts a short,
fixed list of commands. Query values are parsed as numbers and never run.
The placeholders are filled when the file is written for one session: the
token keeps other programs that read VLC's command line (and so its HTTP
password) from driving it. ]]
local expectedToken = "{{SESSION_TOKEN}}"
local maxRate = {{MAX_RATE}}

if _GET["token"] ~= expectedToken then
  print('{"status":"denied"}')
else
  local input = vlc.object.input()
  local command = _GET["command"]

  local function number(name)
    return tonumber(_GET[name])
  end

  if input then
    if command == "seek" then
      local microseconds = number("us")
      if microseconds and microseconds >= 0 then
        vlc.var.set(input, "time", math.floor(microseconds))
      end
    elseif command == "lap" then
      -- A seek and a play in one request, for a passage's lap: VLC's input
      -- takes them together and waits for the picture before the sound
      -- starts. A seek while paused and a play after start the sound first,
      -- the picture catching up once the video decoded to it.
      local microseconds = number("us")
      if microseconds and microseconds >= 0 then
        vlc.var.set(input, "time", math.floor(microseconds))
        if vlc.playlist.status() == "paused" then vlc.playlist.pause() end
      end
    elseif command == "prepare" then
      -- A passage's next lap, made ready during its gap: paused, a seek
      -- shows no picture, and one frame forward decodes to the target and
      -- shows it, so the play after starts at once.
      local microseconds = number("us")
      if microseconds and microseconds >= 0 then
        if vlc.playlist.status() == "playing" then vlc.playlist.pause() end
        vlc.var.set(input, "time", math.floor(microseconds))
        vlc.var.trigger_callback(input, "frame-next")
      end
    elseif command == "pause" then
      if vlc.playlist.status() == "playing" then vlc.playlist.pause() end
    elseif command == "play" then
      if vlc.playlist.status() == "paused" then vlc.playlist.pause() end
    elseif command == "rate" then
      local rate = number("value")
      if rate and rate > 0 and rate <= maxRate then vlc.var.set(input, "rate", rate) end
    elseif command == "frame" then
      vlc.var.trigger_callback(input, "frame-next")
    elseif command == "fullscreen" then
      local vout = vlc.object.vout()
      if vout then vlc.var.set(vout, "fullscreen", _GET["value"] == "1") end
    elseif command == "volume" then
      -- VLC's own scale: 256 is 100%, 512 the app's ceiling of 200%.
      local level = number("value")
      if level and level >= 0 and level <= 512 then vlc.volume.set(math.floor(level)) end
    elseif command == "audio" then
      local index = number("index")
      local ok, ids = pcall(vlc.var.get_list, input, "audio-es")
      if ok and ids and index then
        local position = 0
        for _, id in ipairs(ids) do
          if id >= 0 then
            if position == index then
              vlc.var.set(input, "audio-es", id)
              break
            end
            position = position + 1
          end
        end
      end
    end
  end

  if command == "quit" then
    vlc.misc.quit()
  end

  if input then
    -- The playing audio track by its position among the audio tracks, as
    -- the "audio" command counts them; -1 for none.
    local audio = -1
    local okList, ids = pcall(vlc.var.get_list, input, "audio-es")
    local okCurrent, current = pcall(vlc.var.get, input, "audio-es")
    if okList and okCurrent and ids then
      local position = 0
      for _, id in ipairs(ids) do
        if id >= 0 then
          if id == current then audio = position end
          position = position + 1
        end
      end
    end
    -- %.0f, not %d: VLC's Lua formats %d as a 32-bit int, which overflows
    -- at 2^31 microseconds (35 min 47 s).
    print(string.format('{"status":"%s","time":%.0f,"length":%.0f,"rate":%.4f,"volume":%.0f,"audio":%.0f}',
      vlc.playlist.status(), math.floor(vlc.var.get(input, "time")),
      math.floor(vlc.var.get(input, "length")), vlc.var.get(input, "rate"), vlc.volume.get(), audio))
  else
    print('{"status":"stopped","time":0,"length":0,"rate":1,"audio":-1}')
  end
end
?>
